{minimum_otp_vsn, "24.0"}.

{erl_opts, [debug_info,
           warnings_as_errors,
           warn_untyped_record]}.

{eunit_opts, [verbose]}.
{edoc_opts, [preprocess,
             {dir, "edoc"}]}.
{cover_enabled, true}.
{xref_checks, [undefined_function_calls]}.
{deps, [
  {eleveldb, {git, "https://github.com/OpenRiak/eleveldb.git", {branch, "openriak-3.6"}}}
]}.

{profiles, [
    {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]}
]}.

{plugins,
  [
    {eqc_rebar, {git, "https://github.com/Quviq/eqc-rebar", {branch, "master"}}},
    {pc, {git, "https://github.com/OpenRiak/port_compiler", {branch, "openriak-3.6"}}}
  ]
}.
{provider_hooks,
 [
  {pre,
   [
    {compile, {pc, compile}},
    {clean, {pc, clean}}
   ]
  }
 ]
}.

{port_specs,
 [{".*", "priv/riak_ensemble.so",
   ["c_src/*.c*"],
   [{env, [{"CFLAGS", "$CFLAGS"}]}]
  }]}.
